---
interface Props {
  title: string;
  description: string;
  tags: string[];
  images: string[];
  slug: string;
  year?: number;
  role?: string;
}

const { title, description, tags, images, slug, year, role } = Astro.props;
const thumb = images[0] ?? '/assets/projects/placeholder.svg';
---
<a class="card" href={`/projects/${slug}`}>
  <div class="card-thumb">
    <img src={thumb} alt={title} loading="lazy">
  </div>
  <div class="card-body">
    {(year || role) && (
      <p class="card-meta">{year}{year && role ? ' · ' : ''}{role}</p>
    )}
    <h3>{title}</h3>
    <p>{description}</p>
    <div class="tags">
      {tags.map(t => <span class="tag">{t}</span>)}
    </div>
  </div>
</a>
