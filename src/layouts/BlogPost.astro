---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  author?: string;
  heroImage?: string;
}

const { title, description, pubDate, updatedDate, tags = [], author = 'Zack Dell', heroImage } = Astro.props;
const pubDateStr = pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const updatedStr = updatedDate?.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={`${title} — Zack Dell`} description={description}>
  <div class="bg-overlay" aria-hidden="true"></div>
  <main class="wrap">
    <article>
      <header style="margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.08)">
        <p style="color:var(--muted);font-size:0.9rem;margin:0 0 8px 0">
          <a href="/blog" style="color:var(--accent);text-decoration:none">← Blog</a>
        </p>
        <h1 style="color:#fff;margin:0 0 8px 0">{title}</h1>
        <p style="color:var(--muted);font-size:0.9rem;margin:0">
          {author} · <time datetime={pubDate.toISOString()}>{pubDateStr}</time>
          {updatedStr && <span> · Updated {updatedStr}</span>}
        </p>
        {tags.length > 0 && (
          <div class="blog-tags" style="margin-top:12px">
            {tags.map(tag => <span class="tag">{tag}</span>)}
          </div>
        )}
      </header>
      {heroImage && <img src={heroImage} alt="" style="width:100%;border-radius:12px;margin-bottom:2rem;max-height:400px;object-fit:cover">}
      <div class="prose">
        <slot />
      </div>
    </article>
  </main>
</Base>
