---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogUrl?: string;
}

const { title, description, ogUrl = Astro.url.href } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content={description}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={ogUrl}>
  <meta property="og:type" content="website">
  <meta name="theme-color" content="#0b1116">
  <link rel="canonical" href={canonicalUrl}>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect fill='%23000'/><text x='50' y='75' font-size='65' font-weight='bold' text-anchor='middle' fill='%23fff' font-family='sans-serif'>ZD</text></svg>">
  <link rel="alternate" type="application/rss+xml" title="Zack Dell's Blog" href="/rss.xml">
  <title>{title}</title>
  <!-- Analytics: uncomment and replace domain to enable Plausible -->
  <!-- <script defer data-domain="zackdell.com" src="https://plausible.io/js/script.js"></script> -->
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <h1 class="name"><a href="/" style="color:inherit;text-decoration:none">Zack Dell</a></h1>
      <nav class="nav">
        <a href="/">Home</a>
        <a href="/about">About</a>
        <a href="/projects">Projects</a>
        <a href="/blog">Blog</a>
        <a href="/services">Services</a>
        <a href="/resume">Resume</a>
        <a href="/contact">Contact</a>
      </nav>
    </div>
  </header>

  <slot />

  <footer class="site-footer">
    <div class="wrap">
      <div>© Zack Dell — <a href="mailto:zackdell@pm.me" style="color:var(--accent)">zackdell@pm.me</a></div>
      <div class="social-links">
        <a href="/rss.xml" title="RSS Feed">RSS</a>
        <a href="https://github.com/PyroFlareX" target="_blank" rel="noopener" title="GitHub">GitHub</a>
      </div>
    </div>
  </footer>
</body>
</html>
