---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import resumeData from '../data/resume-data.json';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const projectsForResume = allProjects
  .sort((a, b) => b.data.year - a.data.year)
  .map(p => ({
    title: p.data.title,
    description: p.data.description,
    long_description: p.data.long_description ?? p.data.description,
    tags: p.data.tags,
    year: p.data.year,
    role: p.data.role,
    highlights: p.data.highlights ?? [],
    outcome: p.data.outcome ?? '',
  }));
---
<Base
  title="Resume — Zack Dell"
  description="Zack Dell's resume — experience, skills, and education in systems engineering and embedded development."
>
  <div class="bg-overlay" aria-hidden="true"></div>
  <main class="wrap resume-view">
    <section class="resume-header">
      <h1 style="color:#fff;margin:0 0 4px 0">{resumeData.personal.name}</h1>
      <p style="color:var(--muted);margin:0 0 4px 0;font-style:italic">{resumeData.personal.title}</p>
      <p style="font-size:0.9rem;margin:0;color:var(--muted)">
        <a href={`mailto:${resumeData.personal.email}`} style="color:var(--accent)">{resumeData.personal.email}</a>
        {' · '}{resumeData.personal.phone}
        {' · '}{resumeData.personal.location}
        {' · '}<a href={resumeData.personal.github} target="_blank" rel="noopener" style="color:var(--accent)">GitHub</a>
        {resumeData.personal.linkedin && <>{' · '}<a href={resumeData.personal.linkedin} target="_blank" rel="noopener" style="color:var(--accent)">LinkedIn</a></>}
      </p>
    </section>

    <!-- AI Resume Tailor -->
    <section id="resume-tailor" style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-radius:12px;padding:1.5rem;margin:2rem 0">
      <h2 style="margin-top:0;font-size:1.1rem">Resume Tailor</h2>
      <p style="color:var(--muted);font-size:0.9rem;margin-bottom:1rem">Paste a job description to generate a tailored resume optimized for that role.</p>

      <div style="margin-bottom:1rem">
        <label style="font-size:0.9rem;color:var(--muted);display:block;margin-bottom:6px">Claude API Key</label>
        <div style="display:flex;gap:8px">
          <input type="password" id="api-key-input" placeholder="sk-ant-..." style="flex:1;font-family:monospace;font-size:0.85rem">
          <button id="save-key-btn" type="button">Save Key</button>
        </div>
        <p style="font-size:0.8rem;color:var(--muted);margin:6px 0 0 0">
          Get your key at <a href="https://console.anthropic.com/" target="_blank" rel="noopener" style="color:var(--accent)">console.anthropic.com</a>. Stored locally in your browser only.
        </p>
      </div>

      <div style="margin-bottom:1rem">
        <label style="font-size:0.9rem;color:var(--muted);display:block;margin-bottom:6px">Job Description</label>
        <textarea id="job-desc-input" placeholder="Paste the full job description here..." style="width:100%;min-height:150px;resize:vertical;font-size:0.9rem"></textarea>
      </div>

      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <button id="generate-btn" type="button" style="background:linear-gradient(90deg,#28a745,#20c997)">Generate Tailored Resume</button>
        <button id="download-full-btn" type="button" style="background:linear-gradient(90deg,#17a2b8,#007bff)">Download Full Resume</button>
        <button id="download-tailored-btn" type="button" style="display:none;background:linear-gradient(90deg,#ffc107,#fd7e14);color:#222">Download Tailored Resume</button>
      </div>

      <div id="tailor-status" style="margin-top:12px;font-size:0.9rem;color:var(--muted)"></div>
    </section>

    <section class="resume-section" style="margin-top:2rem">
      <h2>Full Resume</h2>
      <div id="resume-preview" style="color:var(--text)">Loading…</div>
    </section>
  </main>
</Base>

<script define:vars={{ resumeData, projectsForResume }}>
  // API key management
  const apiKeyInput = document.getElementById('api-key-input');
  const saveKeyBtn = document.getElementById('save-key-btn');
  const savedKey = localStorage.getItem('resume_claude_api_key');
  if (savedKey && apiKeyInput) {
    apiKeyInput.value = '••••••••' + savedKey.slice(-4);
    apiKeyInput.dataset.hasKey = 'true';
  }

  saveKeyBtn?.addEventListener('click', () => {
    let key = apiKeyInput?.value ?? '';
    if (key.includes('•')) key = '';
    if (key && key.startsWith('sk-')) {
      localStorage.setItem('resume_claude_api_key', key);
      if (apiKeyInput) { apiKeyInput.value = '••••••••' + key.slice(-4); apiKeyInput.dataset.hasKey = 'true'; }
      alert('API key saved.');
    } else if (key) {
      alert('Invalid key — must start with sk-');
    }
  });

  // Build the full resume HTML
  function buildHTMLResume(projects, skills, experience) {
    let html = `<div class="resume-content" style="color:#e6eef6;font-family:system-ui,sans-serif">
      <section style="margin-bottom:1.5rem;padding-bottom:1rem;border-bottom:1px solid rgba(255,255,255,0.1)">
        <h1 style="margin:0 0 4px 0;color:#fff">${resumeData.personal.name}</h1>
        <p style="margin:0 0 4px 0;font-style:italic;color:#9aa6b2">${resumeData.personal.title}</p>
        <p style="margin:0;font-size:0.9rem;color:#9aa6b2">${resumeData.personal.email} · ${resumeData.personal.location}</p>
      </section>

      <section style="margin-bottom:1.5rem">
        <h2 style="font-size:1rem;border-bottom:1px solid rgba(255,255,255,0.1);padding-bottom:4px;margin:0 0 10px 0;color:#dbeeff">Core Competencies</h2>
        <ul style="columns:2;column-gap:1.5rem;margin:0;padding-left:1.4rem;color:#9aa6b2">
          ${skills.map(s => `<li style="margin-bottom:4px">${s}</li>`).join('')}
        </ul>
      </section>`;

    if (experience?.length) {
      html += `<section style="margin-bottom:1.5rem">
        <h2 style="font-size:1rem;border-bottom:1px solid rgba(255,255,255,0.1);padding-bottom:4px;margin:0 0 10px 0;color:#dbeeff">Work Experience</h2>`;
      experience.forEach(exp => {
        html += `<article style="margin-bottom:1.2rem">
          <h3 style="margin:0 0 2px 0;color:#fff;font-size:1rem">${exp.position}</h3>
          <p style="margin:0 0 6px 0;color:#9aa6b2;font-size:0.9rem">${exp.company} · ${exp.location} · ${exp.duration}</p>
          <ul style="margin:0;padding-left:1.4rem;color:#9aa6b2">
            ${exp.highlights.map(h => `<li style="margin-bottom:3px">${h}</li>`).join('')}
          </ul>
        </article>`;
      });
      html += `</section>`;
    }

    if (projects?.length) {
      html += `<section style="margin-bottom:1.5rem">
        <h2 style="font-size:1rem;border-bottom:1px solid rgba(255,255,255,0.1);padding-bottom:4px;margin:0 0 10px 0;color:#dbeeff">Projects</h2>`;
      projects.forEach(proj => {
        const tags = (proj.tags || []).map(t => `<span style="background:rgba(255,255,255,0.05);color:#9aa6b2;padding:2px 8px;border-radius:12px;font-size:0.8rem;border:1px solid rgba(255,255,255,0.06)">${t}</span>`).join(' ');
        html += `<article style="margin-bottom:1.2rem">
          <h3 style="margin:0 0 2px 0;color:#fff;font-size:1rem">${proj.title}</h3>
          <p style="margin:0 0 4px 0;color:#9aa6b2;font-size:0.9rem">${proj.role} · ${proj.year}</p>
          <p style="margin:0 0 6px 0;color:#9aa6b2;font-size:0.95rem">${proj.long_description || proj.description}</p>
          <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:6px">${tags}</div>
          ${proj.highlights?.length ? `<ul style="margin:0;padding-left:1.4rem;color:#9aa6b2">${proj.highlights.map(h => `<li style="margin-bottom:3px">${h}</li>`).join('')}</ul>` : ''}
        </article>`;
      });
      html += `</section>`;
    }

    html += `</div>`;
    return html;
  }

  let currentResumeHtml = null;

  function displayFullResume() {
    currentResumeHtml = buildHTMLResume(projectsForResume, resumeData.coreskills, resumeData.experience);
    const preview = document.getElementById('resume-preview');
    if (preview) preview.innerHTML = currentResumeHtml;
  }
  displayFullResume();

  // Generate tailored resume via Claude API
  document.getElementById('generate-btn')?.addEventListener('click', async () => {
    const jobDesc = document.getElementById('job-desc-input')?.value.trim();
    const status = document.getElementById('tailor-status');
    if (!jobDesc) { if (status) status.textContent = 'Paste a job description first.'; return; }
    const apiKey = localStorage.getItem('resume_claude_api_key');
    if (!apiKey) { if (status) status.textContent = 'Save your Claude API key first.'; return; }
    if (status) status.textContent = 'Analyzing job description…';

    try {
      const prompt = `You are an expert resume optimizer. Given a resume and job description, create a tailored resume that prioritizes the most relevant projects and skills, highlights achievements that match job requirements, and uses keywords from the job description naturally. Maintain authenticity—never invent experience. Include ALL projects and ALL work experience.

Return ONLY valid HTML resume content (no markdown, no extra text, no code blocks). Start with <div class="resume-content"> and use semantic HTML5. Do NOT include <html>, <head>, <body>, or <style> tags.

RESUME DATA:
${JSON.stringify({ personal: resumeData.personal, coreskills: resumeData.coreskills, experience: resumeData.experience, projects: projectsForResume }, null, 2)}

JOB DESCRIPTION:
${jobDesc}`;

      const response = await fetch('https://api.anthropic.com/v1/messages', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-api-key': apiKey,
          'anthropic-version': '2023-06-01',
          'anthropic-dangerous-direct-browser-access': 'true',
        },
        body: JSON.stringify({
          model: 'claude-sonnet-4-6',
          max_tokens: 2000,
          messages: [{ role: 'user', content: prompt }],
        }),
      });

      if (!response.ok) {
        const err = await response.json();
        throw new Error(err.error?.message ?? 'API request failed');
      }

      const data = await response.json();
      currentResumeHtml = data.content[0].text;
      const preview = document.getElementById('resume-preview');
      if (preview) preview.innerHTML = currentResumeHtml;
      if (status) status.textContent = 'Tailored resume generated.';
      const dlBtn = document.getElementById('download-tailored-btn');
      if (dlBtn) dlBtn.style.display = 'inline-block';
    } catch (err) {
      if (status) status.textContent = `Error: ${err.message}`;
    }
  });

  // PDF download
  async function downloadPDF(type) {
    const content = document.getElementById('resume-preview');
    if (!content) return;
    const script = document.createElement('script');
    script.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js';
    script.onload = () => {
      const filename = type === 'full'
        ? `Zack_Dell_Resume_Full_${new Date().toISOString().split('T')[0]}.pdf`
        : `Zack_Dell_Resume_Tailored_${new Date().toISOString().split('T')[0]}.pdf`;
      const clone = content.cloneNode(true);
      clone.style.cssText = 'padding:20px;font-size:11px;line-height:1.5;color:#222;font-family:Arial,sans-serif;background:white';
      // Make text dark for PDF
      clone.querySelectorAll('*').forEach(el => {
        el.style.color = el.style.color?.includes('9aa6b2') || el.style.color?.includes('e6eef6') ? '#333' : el.style.color;
      });
      html2pdf().set({
        margin: [10, 10, 10, 10],
        filename,
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: { scale: 2, useCORS: true, backgroundColor: '#ffffff' },
        jsPDF: { orientation: 'portrait', unit: 'mm', format: 'a4' },
      }).from(clone).save();
    };
    document.head.appendChild(script);
  }

  document.getElementById('download-full-btn')?.addEventListener('click', () => downloadPDF('full'));
  document.getElementById('download-tailored-btn')?.addEventListener('click', () => downloadPDF('tailored'));
</script>
