---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import resumeData from '../data/resume-data.json';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const projectsForResume = allProjects
  .sort((a, b) => b.data.year - a.data.year)
  .map(p => ({
    title: p.data.title,
    description: p.data.description,
    long_description: p.data.long_description ?? p.data.description,
    tags: p.data.tags,
    year: p.data.year,
    role: p.data.role,
    highlights: p.data.highlights ?? [],
    outcome: p.data.outcome ?? '',
  }));

function fmtDate(ym: string | null) {
  if (!ym) return 'Present';
  const [y, m] = ym.split('-');
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  return `${months[parseInt(m) - 1]} ${y}`;
}
---
<Base
  title="Resume — Zack Dell"
  description="Zack Dell's resume — embedded systems engineer & C++ developer. Experience, skills, and education."
>
  <main class="wrap resume-view">

    <!-- ── Header ── -->
    <section class="resume-header">
      <h1 style="color:var(--text);margin:0 0 4px 0;font-size:clamp(1.8rem,4vw,2.8rem)">{resumeData.personal.name}</h1>
      <p style="color:var(--accent);margin:0 0 12px 0;font-family:var(--font-mono);font-size:0.85rem;letter-spacing:0.06em">{resumeData.personal.title}</p>
      <p style="font-size:0.9rem;margin:0;color:var(--muted);font-family:var(--font-mono);font-size:0.78rem;letter-spacing:0.04em">
        <a href={`mailto:${resumeData.personal.email}`} style="color:var(--accent)">{resumeData.personal.email}</a>
        {' · '}{resumeData.personal.location}
        {' · '}<a href={resumeData.personal.github} target="_blank" rel="noopener" style="color:var(--accent)">GitHub</a>
      </p>
      <p style="color:var(--muted);font-size:0.95rem;margin:16px 0 0;max-width:72ch;line-height:1.65">{resumeData.personal.summary}</p>
    </section>

    <!-- ── Skills ── -->
    <section class="resume-section">
      <h2>Skills</h2>
      <div class="skills-grid">
        {Object.entries(resumeData.skills).map(([group, items]) => (
          <div class="skill-group">
            <h3>{group}</h3>
            <ul>
              {(items as string[]).map(s => <li>{s}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- ── Experience ── -->
    <section class="resume-section">
      <h2>Work Experience</h2>
      <div class="timeline">
        {resumeData.experience.map(exp => (
          <div class="timeline-item">
            <p class="timeline-date">{fmtDate(exp.start)} – {fmtDate(exp.end ?? null)}</p>
            <p class="timeline-title">{exp.position}</p>
            <p class="timeline-org">{exp.employer} · {exp.location}</p>
            <ul class="timeline-bullets">
              {exp.highlights.map(h => <li>{h}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- ── Research ── -->
    <section class="resume-section">
      <h2>Research</h2>
      <div class="timeline">
        {resumeData.research.map(r => (
          <div class="timeline-item">
            <p class="timeline-date">{fmtDate(r.start)} – {fmtDate(r.end)}</p>
            <p class="timeline-title">{r.topic}</p>
            <p class="timeline-org">{r.role} · {r.institution} · Advisor: {r.advisor}</p>
            <ul class="timeline-bullets">
              {r.highlights.map(h => <li>{h}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- ── Projects ── -->
    <section class="resume-section">
      <h2>Projects</h2>
      <div class="timeline">
        {projectsForResume.map(proj => (
          <div class="timeline-item">
            <p class="timeline-date">{proj.year}</p>
            <p class="timeline-title">{proj.title}</p>
            <p class="timeline-org">{proj.role}</p>
            {proj.highlights.length > 0 && (
              <ul class="timeline-bullets">
                {proj.highlights.map(h => <li>{h}</li>)}
              </ul>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- ── Education ── -->
    <section class="resume-section">
      <h2>Education</h2>
      <div class="timeline">
        {resumeData.education.map(edu => (
          <div class="timeline-item">
            <p class="timeline-date">{fmtDate(edu.start)} – {fmtDate(edu.end)}</p>
            <p class="timeline-title">{edu.degree}</p>
            <p class="timeline-org">{edu.institution} · {edu.location}{edu.minor ? ` · Minor: ${edu.minor}` : ''}</p>
            {edu.relevant_courses && edu.relevant_courses.length > 0 && (
              <ul class="timeline-bullets">
                {edu.relevant_courses.map(c => <li>{c}</li>)}
              </ul>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- ── Certifications ── -->
    <section class="resume-section">
      <h2>Certifications</h2>
      <div class="timeline">
        {resumeData.certifications.map(cert => (
          <div class="timeline-item">
            <p class="timeline-title">{cert.name}</p>
            <p class="timeline-org">{cert.issuer} · {cert.status}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ── Leadership ── -->
    <section class="resume-section">
      <h2>Leadership & Activities</h2>
      <div class="timeline">
        {resumeData.leadership.map((l: { org: string; role: string; start: string; end?: string | null; bullets?: string[] }) => (
          <div class="timeline-item">
            <p class="timeline-date">{fmtDate(l.start)} – {fmtDate(l.end ?? null)}</p>
            <p class="timeline-title">{l.role}</p>
            <p class="timeline-org">{l.org}</p>
            {l.bullets && l.bullets.length > 0 && (
              <ul class="timeline-bullets">
                {l.bullets.map((b: string) => <li>{b}</li>)}
              </ul>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- ── AI Resume Tailor (collapsed, at bottom) ── -->
    <details class="resume-tailor">
      <summary>AI Resume Tailor</summary>
      <div class="resume-tailor-body">
        <p style="color:var(--muted);font-size:0.9rem;margin-bottom:1.2rem">Paste a job description to generate a tailored resume optimized for that role.</p>

        <div style="margin-bottom:1rem">
          <label for="api-key-input">Claude API Key</label>
          <div style="display:flex;gap:8px">
            <input type="password" id="api-key-input" placeholder="sk-ant-..." style="flex:1;font-family:var(--font-mono);font-size:0.85rem">
            <button id="save-key-btn" type="button">Save Key</button>
          </div>
          <p style="font-size:0.8rem;color:var(--muted);margin:6px 0 0 0">
            Get your key at <a href="https://console.anthropic.com/" target="_blank" rel="noopener">console.anthropic.com</a>. Stored locally in your browser only.
          </p>
        </div>

        <div style="margin-bottom:1rem">
          <label for="job-desc-input">Job Description</label>
          <textarea id="job-desc-input" placeholder="Paste the full job description here..." style="width:100%;min-height:150px;resize:vertical;font-size:0.9rem"></textarea>
        </div>

        <div style="display:flex;gap:10px;flex-wrap:wrap">
          <button id="generate-btn" type="button">Generate Tailored Resume</button>
          <button id="download-full-btn" type="button" class="ghost">Download Full Resume</button>
          <button id="download-tailored-btn" type="button" style="display:none" class="ghost">Download Tailored Resume</button>
        </div>

        <div id="tailor-status" style="margin-top:12px;font-size:0.9rem;color:var(--muted)"></div>
        <div id="tailor-preview" style="margin-top:1.5rem;color:var(--text)"></div>
      </div>
    </details>

  </main>
</Base>

<script define:vars={{ resumeData, projectsForResume }}>
  // API key management
  const apiKeyInput = document.getElementById('api-key-input');
  const saveKeyBtn = document.getElementById('save-key-btn');
  const savedKey = localStorage.getItem('resume_claude_api_key');
  if (savedKey && apiKeyInput) {
    apiKeyInput.value = '••••••••' + savedKey.slice(-4);
    apiKeyInput.dataset.hasKey = 'true';
  }

  saveKeyBtn?.addEventListener('click', () => {
    let key = apiKeyInput?.value ?? '';
    if (key.includes('•')) key = '';
    if (key && key.startsWith('sk-')) {
      localStorage.setItem('resume_claude_api_key', key);
      if (apiKeyInput) { apiKeyInput.value = '••••••••' + key.slice(-4); apiKeyInput.dataset.hasKey = 'true'; }
      alert('API key saved.');
    } else if (key) {
      alert('Invalid key — must start with sk-');
    }
  });

  // Generate tailored resume via Claude API
  document.getElementById('generate-btn')?.addEventListener('click', async () => {
    const jobDesc = document.getElementById('job-desc-input')?.value.trim();
    const status = document.getElementById('tailor-status');
    if (!jobDesc) { if (status) status.textContent = 'Paste a job description first.'; return; }
    const apiKey = localStorage.getItem('resume_claude_api_key');
    if (!apiKey) { if (status) status.textContent = 'Save your Claude API key first.'; return; }
    if (status) status.textContent = 'Analyzing job description…';

    try {
      const prompt = `You are an expert resume optimizer. Given a resume and job description, create a tailored resume that prioritizes the most relevant projects and skills, highlights achievements that match job requirements, and uses keywords from the job description naturally. Maintain authenticity—never invent experience. Include ALL projects and ALL work experience.

Return ONLY valid HTML resume content (no markdown, no extra text, no code blocks). Start with <div class="resume-content"> and use semantic HTML5. Do NOT include <html>, <head>, <body>, or <style> tags.

RESUME DATA:
${JSON.stringify({ personal: resumeData.personal, coreskills: resumeData.coreskills, experience: resumeData.experience, projects: projectsForResume }, null, 2)}

JOB DESCRIPTION:
${jobDesc}`;

      const response = await fetch('https://api.anthropic.com/v1/messages', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-api-key': apiKey,
          'anthropic-version': '2023-06-01',
          'anthropic-dangerous-direct-browser-access': 'true',
        },
        body: JSON.stringify({
          model: 'claude-sonnet-4-6',
          max_tokens: 2000,
          messages: [{ role: 'user', content: prompt }],
        }),
      });

      if (!response.ok) {
        const err = await response.json();
        throw new Error(err.error?.message ?? 'API request failed');
      }

      const data = await response.json();
      const tailoredHtml = data.content[0].text;
      const preview = document.getElementById('tailor-preview');
      if (preview) preview.innerHTML = tailoredHtml;
      if (status) status.textContent = 'Tailored resume generated.';
      const dlBtn = document.getElementById('download-tailored-btn');
      if (dlBtn) dlBtn.style.display = 'inline-flex';
    } catch (err) {
      if (status) status.textContent = `Error: ${err.message}`;
    }
  });

  // PDF download
  async function downloadPDF(type) {
    const content = type === 'full'
      ? document.querySelector('main.resume-view')
      : document.getElementById('tailor-preview');
    if (!content) return;
    const script = document.createElement('script');
    script.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js';
    script.onload = () => {
      const filename = type === 'full'
        ? `Zack_Dell_Resume_Full_${new Date().toISOString().split('T')[0]}.pdf`
        : `Zack_Dell_Resume_Tailored_${new Date().toISOString().split('T')[0]}.pdf`;
      const clone = content.cloneNode(true);
      clone.style.cssText = 'padding:20px;font-size:11px;line-height:1.5;color:#222;font-family:Arial,sans-serif;background:white;max-width:none';
      clone.querySelectorAll('*').forEach(el => {
        el.style.color = '';
        el.style.background = '';
      });
      html2pdf().set({
        margin: [10, 10, 10, 10],
        filename,
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: { scale: 2, useCORS: true, backgroundColor: '#ffffff' },
        jsPDF: { orientation: 'portrait', unit: 'mm', format: 'a4' },
      }).from(clone).save();
    };
    document.head.appendChild(script);
  }

  document.getElementById('download-full-btn')?.addEventListener('click', () => downloadPDF('full'));
  document.getElementById('download-tailored-btn')?.addEventListener('click', () => downloadPDF('tailored'));
</script>
