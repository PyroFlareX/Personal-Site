---
import Base from '../layouts/Base.astro';
---
<Base
  title="Services — Zack Dell"
  description="Services offered: systems design, firmware, PCB design, and automation for manufacturing."
>
  <div class="bg-overlay" aria-hidden="true"></div>
  <main class="wrap">
    <section id="services-page">
      <h2>Services</h2>
      <ul class="services-list">
        <li>
          <strong>Embedded C++ Development</strong>
          <p>Real-time, constrained systems, safety-minded code and hardware integration.</p>
        </li>
        <li>
          <strong>Systems Engineering</strong>
          <p>Requirements, architecture, test plans, and integration for robust production systems.</p>
        </li>
        <li>
          <strong>Manufacturing Automation</strong>
          <p>PLC interfaces, motion control, and real-time alerting software.</p>
        </li>
        <li>
          <strong>Electronics & Firmware</strong>
          <p>PCB design, sensor integration, and firmware bringing hardware to life.</p>
        </li>
      </ul>
    </section>
  </main>
</Base>
