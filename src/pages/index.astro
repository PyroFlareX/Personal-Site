---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const projects = allProjects.sort((a, b) => b.data.year - a.data.year);
const featured = projects.slice(0, 4);
---
<Base
  title="Zack Dell — Embedded Systems Engineer & C++ Developer"
  description="Embedded systems engineer & C++ developer. Multi-layer PCB design, firmware, GPU compute pipelines, and real-time systems."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Zack Dell",
    "url": "https://zackdell.com",
    "email": "zackdell@pm.me",
    "sameAs": ["https://github.com/PyroFlareX"],
    "jobTitle": "Embedded Systems Engineer",
    "description": "Embedded systems engineer & C++ developer working across the hardware–software stack."
  })} />

  <main class="wrap">

    <!-- ── Hero ── -->
    <section id="hero">
      <div class="hero-left">
        <span class="eyebrow">EMBEDDED · MANUFACTURING · AD ASTRA</span>
        <h1>Embedded systems engineer &amp; C++ developer.</h1>
        <p class="lead">I work across the hardware–software stack — from multi-layer PCB design and firmware to GPU compute pipelines and real-time systems. Built for the factory floor, aimed higher.</p>
        <div class="hero-ctas">
          <a class="cta" href="/projects">View projects →</a>
          <a class="cta ghost" href="/resume">Resume</a>
        </div>
        <div class="hero-chips">
          <span>C++</span>
          <span>Vulkan</span>
          <span>KiCad</span>
          <span>Linux</span>
          <span>Python</span>
        </div>
        <p class="hero-caption">// per aspera ad astra</p>
      </div>

      <div class="hero-right" aria-hidden="true">
        <!-- Launch-trajectory schematic SVG: PCB → orbit arc -->
        <svg viewBox="0 0 500 440" width="500" height="440" style="max-width:100%" xmlns="http://www.w3.org/2000/svg">
          <!-- Board outline -->
          <g class="board-group">
            <rect class="draw-in" x="40" y="310" width="220" height="110" rx="8"
              fill="none" stroke="#e09456" stroke-width="3"
              stroke-dasharray="660" stroke-dashoffset="660"
              style="animation:drawPath 0.8s 0.1s ease forwards"/>
            <!-- PCB traces -->
            <polyline class="draw-in" points="60,340 120,340 120,360 160,360"
              fill="none" stroke="#e09456" stroke-width="2"
              stroke-dasharray="160" stroke-dashoffset="160"
              style="animation:drawPath 0.5s 0.9s ease forwards"/>
            <polyline class="draw-in" points="60,370 90,370 90,390 180,390"
              fill="none" stroke="#5fd1f9" stroke-width="1.5"
              stroke-dasharray="160" stroke-dashoffset="160"
              style="animation:drawPath 0.5s 1.0s ease forwards"/>
            <polyline class="draw-in" points="60,400 100,400 100,410 220,410"
              fill="none" stroke="#e09456" stroke-width="2"
              stroke-dasharray="200" stroke-dashoffset="200"
              style="animation:drawPath 0.5s 1.1s ease forwards"/>
            <!-- Pads -->
            <circle cx="60" cy="340" r="5" fill="#5fd1f9" opacity="0" style="animation:fadeIn 0.3s 1.4s ease forwards"/>
            <circle cx="160" cy="360" r="5" fill="#5fd1f9" opacity="0" style="animation:fadeIn 0.3s 1.5s ease forwards"/>
            <circle cx="180" cy="390" r="5" fill="#5fd1f9" opacity="0" style="animation:fadeIn 0.3s 1.6s ease forwards"/>
            <circle cx="220" cy="410" r="5" fill="#e09456" opacity="0" style="animation:fadeIn 0.3s 1.7s ease forwards"/>
            <!-- IC chip -->
            <rect x="185" y="330" width="50" height="50" rx="3" fill="none" stroke="#e09456" stroke-width="1.5" opacity="0" style="animation:fadeIn 0.4s 1.2s ease forwards"/>
            <rect x="191" y="336" width="38" height="38" rx="2" fill="rgba(224,148,86,0.06)" opacity="0" style="animation:fadeIn 0.4s 1.2s ease forwards"/>
          </g>

          <!-- Trajectory arc: bottom-left PCB → upper-right apogee -->
          <path class="draw-in" d="M 150 310 Q 200 180 380 80"
            fill="none" stroke="rgba(224,148,86,0.6)" stroke-width="2" stroke-dasharray="8,6"
            stroke-dasharray="400" stroke-dashoffset="400"
            style="animation:drawPath 1.2s 1.8s ease forwards"/>

          <!-- Orbit circles (faint) -->
          <ellipse cx="390" cy="75" rx="70" ry="30"
            fill="none" stroke="rgba(95,209,249,0.2)" stroke-width="1.5"
            stroke-dasharray="400" stroke-dashoffset="400"
            style="animation:drawPath 1.0s 3.0s ease forwards"/>
          <ellipse cx="390" cy="75" rx="100" ry="44"
            fill="none" stroke="rgba(95,209,249,0.12)" stroke-width="1"
            stroke-dasharray="560" stroke-dashoffset="560"
            style="animation:drawPath 1.2s 3.2s ease forwards"/>

          <!-- Apogee dot (pulsing) -->
          <circle cx="380" cy="80" r="7" fill="#5fd1f9" opacity="0"
            style="animation:fadeIn 0.4s 3.4s ease forwards, pulse 2s 3.8s ease-in-out infinite"/>
          <circle cx="380" cy="80" r="14" fill="none" stroke="rgba(95,209,249,0.35)" opacity="0"
            style="animation:fadeIn 0.4s 3.4s ease forwards, pulseRing 2s 3.8s ease-in-out infinite"/>
        </svg>
      </div>
    </section>

    <!-- ── Featured Work ── -->
    <section id="featured" style="padding:4rem 0" class="strip">
      <div class="section-header reveal">
        <span class="eyebrow">// FEATURED WORK</span>
        <h2>Selected projects</h2>
      </div>
      <div class="grid">
        {featured.map(p => (
          <div class="reveal">
            <ProjectCard
              title={p.data.title}
              description={p.data.description}
              tags={p.data.tags}
              images={p.data.images}
              slug={p.slug}
              year={p.data.year}
              role={p.data.role}
            />
          </div>
        ))}
      </div>
      <p class="more"><a href="/projects">View all projects →</a></p>
    </section>

    <!-- ── What I Do ── -->
    <section class="strip">
      <div class="section-header reveal">
        <span class="eyebrow">// CAPABILITIES</span>
        <h2>What I do</h2>
      </div>
      <div class="what-i-do-grid">
        <div class="wid-card reveal">
          <p class="wid-index">01</p>
          <h3>Embedded & PCB</h3>
          <p>Multi-layer PCB design, schematic capture, DFM review, PMIC integration, and firmware for power and sensor systems.</p>
          <p class="wid-skills">KiCad · BQ25975 · Li-ion BMS · Hot-swap · Firmware C/C++</p>
        </div>
        <div class="wid-card reveal">
          <p class="wid-index">02</p>
          <h3>GPU & Graphics</h3>
          <p>Vulkan compute pipelines, flowgraph orchestration, multi-queue dispatch, sparse memory, and OpenGL rendering systems.</p>
          <p class="wid-skills">Vulkan 1.2 · OpenGL 3.3+ · GLSL · C++ · Pipeline Architecture</p>
        </div>
        <div class="wid-card reveal">
          <p class="wid-index">03</p>
          <h3>Manufacturing & Automation</h3>
          <p>Assembly-line control, sensor feedback loops, stepper-driven dispensing, web recipe management, and real-time telemetry.</p>
          <p class="wid-skills">Arduino · Stepper Control · Closed-loop · Web UI · PLC-adjacent</p>
        </div>
      </div>
    </section>

    <!-- ── Currently ── -->
    <section class="strip">
      <div class="section-header reveal">
        <span class="eyebrow">// STATUS</span>
        <h2>Currently</h2>
      </div>
      <ul class="currently-list">
        <li class="reveal">Building embedded hardware projects — PCB layout, firmware, and power systems</li>
        <li class="reveal">Running a Proxmox homelab for Linux, VM, and container work</li>
        <li class="reveal">Studying for CompTIA Security+ (DoD 8570)</li>
        <li class="reveal">Open to defense-tech and autonomous-systems roles — <a href="/contact" style="color:var(--accent)">get in touch →</a></li>
      </ul>
    </section>

  </main>
</Base>

<style>
@keyframes drawPath {
  to { stroke-dashoffset: 0 }
}
@keyframes fadeIn {
  to { opacity: 1 }
}
@keyframes pulse {
  0%, 100% { r: 7; opacity: 1 }
  50% { r: 9; opacity: 0.7 }
}
@keyframes pulseRing {
  0%, 100% { r: 14; opacity: 0.35 }
  50% { r: 20; opacity: 0 }
}
@media (prefers-reduced-motion: reduce) {
  svg * { animation: none !important; stroke-dashoffset: 0 !important; opacity: 1 !important }
}
</style>
