---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import TagFilter from '../../components/TagFilter.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const projects = allProjects.sort((a, b) => b.data.year - a.data.year);

const allTags = [...new Set(projects.flatMap(p => p.data.tags))].sort();
---
<Base
  title="Projects — Zack Dell"
  description="Selected projects in embedded systems, PCB design, firmware, GPU compute, and applications."
>
  <main class="wrap" style="padding-top:3rem">
    <div class="section-header reveal">
      <span class="eyebrow">// ALL WORK</span>
      <h2>Projects</h2>
    </div>
    <TagFilter tags={allTags} />
    <div id="projects-grid" class="grid">
      {projects.map(p => (
        <div class="reveal" data-tags={JSON.stringify(p.data.tags)}>
          <ProjectCard
            title={p.data.title}
            description={p.data.description}
            tags={p.data.tags}
            images={p.data.images}
            slug={p.slug}
            year={p.data.year}
            role={p.data.role}
          />
        </div>
      ))}
    </div>
  </main>
</Base>
